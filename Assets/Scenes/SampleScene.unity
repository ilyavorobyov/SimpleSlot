MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1454826087}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f34f36451b093ee4c83ad4aa5459d2ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textMPComponent: {fileID: 1454826089}
  uniqueFontTMP: {fileID: 0}
  textLComponent: {fileID: 0}
  infoYG: {fileID: 11400000, guid: 162644796a8b0d044bce3d6fda0641e3, type: 2}
  text: 
  ru: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443,
    \u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u0431\u0443\u0434\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
    \u0434\u0440\u0443\u0433\u043E\u0439, \u0432\u044B\u0438\u0433\u0440\u044B\u0448
    \u0443\u0434\u0432\u043E\u0438\u0442\u0441\u044F, \u0435\u0441\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435
    - \u0432\u044B\u0438\u0433\u0440\u044B\u0448 \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043D"
  en: Choose one card, if it is larger than the other, the winnings will be doubled,
    if less, the winnings will be lost
  tr: "Bir kart se\xE7in, di\u011Ferinden b\xFCy\xFCkse kazan\xE7 ikiye katlan\u0131r,
    daha azsa kazan\xE7 kaybedilir"
  az: 
  be: 
  he: 
  hy: 
  ka: 
  et: 
  fr: 
  kk: "\u0411\u0456\u0440 \u043A\u0430\u0440\u0442\u0430\u043D\u044B \u0442\u0430\u04A3\u0434\u0430\u04A3\u044B\u0437,
    \u0435\u0433\u0435\u0440 \u043E\u043B \u0435\u043A\u0456\u043D\u0448\u0456\u0441\u0456\u043D\u0435\u043D
    \u04AF\u043B\u043A\u0435\u043D \u0431\u043E\u043B\u0441\u0430, \u04B1\u0442\u044B\u0441
    \u0435\u043A\u0456 \u0435\u0441\u0435\u043B\u0435\u043D\u0435\u0434\u0456, \u0430\u0437
    \u0431\u043E\u043B\u0441\u0430, \u04B1\u0442\u044B\u0441 \u0436\u043E\u0493\u0430\u043B\u0430\u0434\u044B."
  ky: 
  lt: 
  lv: 
  ro: 
  tg: 
  tk: 
  uk: 
  uz: Bitta kartani tanlang, agar u ikkinchisidan katta bo'lsa, yutuq ikki baravar
    ko'payadi, agar kamroq bo'lsa, yutuq yo'qoladi.
  es: "Elija una tarjeta, si es m\xE1s grande que la otra, las ganancias se duplicar\xE1n,
    si es menor, las ganancias se perder\xE1n."
  pt: 
  ar: 
  id: 
  ja: 
  it: 
  de: "W\xE4hlen Sie eine Karte, ist sie gr\xF6\xDFer als die andere, wird der Gewinn
    verdoppelt, ist sie kleiner, geht der Gewinn verloren"
