  m_Script: {fileID: 11500000, guid: f34f36451b093ee4c83ad4aa5459d2ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textMPComponent: {fileID: 1437083347}
  uniqueFontTMP: {fileID: 0}
  textLComponent: {fileID: 0}
  infoYG: {fileID: 11400000, guid: 162644796a8b0d044bce3d6fda0641e3, type: 2}
  text: 
  ru: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0441\u0443\u043D\u0434\u0443\u043A:
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 - \u0432\u044B\u0438\u0433\u0440\u044B\u0448,
    \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 - \u043D\u0438\u0447\u0435\u0433\u043E."
  en: 'Choose a chest: correct - winnings, wrong - nothing.'
  tr: "Bir G\xF6\u011F\xFCs Se\xE7in: Do\u011Fru - Kazan\xE7lar, Yanl\u0131\u015F
    - Hi\xE7bir \u015Eey."
  az: 
  be: 
  he: 
  hy: 
  ka: 
  et: 
  fr: 
  kk: "\u041A\u0435\u0443\u0434\u0435 \u049B\u0443\u044B\u0441\u044B\u043D \u0442\u0430\u04A3\u0434\u0430\u04A3\u044B\u0437:
    \u0434\u04B1\u0440\u044B\u0441 - \u04B1\u0442\u044B\u0441, \u0434\u04B1\u0440\u044B\u0441
    \u0435\u043C\u0435\u0441 - \u0435\u0448\u0442\u0435\u04A3\u0435 \u0436\u043E\u049B."
  ky: 
  lt: 
  lv: 
  ro: 
  tg: 
  tk: 
  uk: 
  uz: 'Ko''krakni tanlang: to''g''ri - yutuqlar, noto''g''ri - hech narsa.'
  es: 
  pt: 
  ar: 
  id: 
  ja: 
  it: 
  de: 
  hi: 
  changeOnlyFont: 0
  fontNumber: 0
  uniqueFont: {fileID: 0}
  additionalText: {fileID: 0}
  textHeight: 20
  processTranslateLabel: 5/5 completed
  componentTextField: 1
  countLang: 5
