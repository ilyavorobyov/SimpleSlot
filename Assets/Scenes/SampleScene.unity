--- !u!114 &1454486328
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1454486324}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f34f36451b093ee4c83ad4aa5459d2ac, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textMPComponent: {fileID: 1454486326}
  uniqueFontTMP: {fileID: 0}
  textLComponent: {fileID: 0}
  infoYG: {fileID: 11400000, guid: 162644796a8b0d044bce3d6fda0641e3, type: 2}
  text: 
  ru: "\u0427\u0442\u043E\u0431\u044B \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
    \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0441\u043B\u043E\u0442\u043E\u0432
    \u0432\u044B\u0431\u0435\u0440\u0438 \u0441\u0442\u0430\u0432\u043A\u0443 \u0438
    \u043D\u0430\u0436\u0438\u043C\u0430\u0439 \u043A\u043D\u043E\u043F\u043A\u0443
    \"\u041A\u0420\u0423\u0422\u0418\u0422\u042C\" \u0432 \u043D\u0438\u0436\u043D\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438 \u044D\u043A\u0440\u0430\u043D\u0430"
  en: To start spinning slots, select a bet and click the "TWIST" button at the bottom
    of the screen
  tr: "Slotlar\u0131 d\xF6nd\xFCrmeye ba\u015Flamak i\xE7in bir bahis se\xE7in ve
    ekran\u0131n alt\u0131ndaki \"B\xDCK\xDCM\" d\xFC\u011Fmesine t\u0131klay\u0131n"
  az: 
  be: 
  he: 
  hy: 
  ka: 
  et: 
  fr: 
  kk: "\u0421\u043B\u043E\u0442\u0442\u0430\u0440\u0434\u044B \u0430\u0439\u043D\u0430\u043B\u0434\u044B\u0440\u0443\u0434\u044B
    \u0431\u0430\u0441\u0442\u0430\u0443 \u04AF\u0448\u0456\u043D \u0441\u0442\u0430\u0432\u043A\u0430\u043D\u044B
    \u0442\u0430\u04A3\u0434\u0430\u043F, \u044D\u043A\u0440\u0430\u043D\u043D\u044B\u04A3
    \u0442\u04E9\u043C\u0435\u043D\u0433\u0456 \u0436\u0430\u0493\u044B\u043D\u0434\u0430\u0493\u044B
    \xAB\u0411\u04B0\u0420\u0410\u0423\xBB \u0442\u04AF\u0439\u043C\u0435\u0441\u0456\u043D
    \u0431\u0430\u0441\u044B\u04A3\u044B\u0437"
  ky: 
  lt: 
  lv: 
  ro: 
  tg: 
  tk: 
  uk: 
  uz: Slotlarni aylantirishni boshlash uchun garovni tanlang va ekranning pastki
    qismidagi "BURISH" tugmasini bosing
  es: "Para comenzar a girar tragamonedas, seleccione una apuesta y haga clic en
    el bot\xF3n \"GIRAR\" en la parte inferior de la pantalla"
  pt: 
  ar: 
  id: 
  ja: 
  it: 
  de: "Um mit dem Drehen der Spielautomaten zu beginnen, w\xE4hlen Sie einen Einsatz
    aus und klicken Sie unten auf dem Bildschirm auf die Schaltfl\xE4che \u201ETWIST\u201C"
  hi: 
  changeOnlyFont: 0
  fontNumber: 0
  uniqueFont: {fileID: 0}
  additionalText: {fileID: 0}
  textHeight: 20
  processTranslateLabel: 7/7 completed
  componentTextField: 1
  countLang: 7
