  infoYG: {fileID: 11400000, guid: 162644796a8b0d044bce3d6fda0641e3, type: 2}
  text: 
  ru: "\u041D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0434\u0435\u043D\u0435\u0433,
    \u0443\u043C\u0435\u043D\u044C\u0448\u0438 \u0441\u0442\u0430\u0432\u043A\u0443
    \u0438\u043B\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u044C \u0431\u0430\u043B\u0430\u043D\u0441"
  en: Not enough money, reduce the bet or increase the balance
  tr: "Yeterli para yok, bahsi azalt\u0131n veya bakiyeyi art\u0131r\u0131n"
  az: 
  be: 
  he: 
  hy: 
  ka: 
  et: 
  fr: 
  kk: "\u0410\u049B\u0448\u0430 \u0436\u0435\u0442\u043A\u0456\u043B\u0456\u043A\u0441\u0456\u0437,
    \u0441\u0442\u0430\u0432\u043A\u0430\u043D\u044B \u0430\u0437\u0430\u0439\u0442\u044B\u04A3\u044B\u0437
    \u043D\u0435\u043C\u0435\u0441\u0435 \u0442\u0435\u04A3\u0433\u0435\u0440\u0456\u043C\u0434\u0456
    \u043A\u04E9\u0431\u0435\u0439\u0442\u0456\u04A3\u0456\u0437"
  ky: 
  lt: 
  lv: 
  ro: 
  tg: 
  tk: 
  uk: 
  uz: Pul yetarli emas, tikishni kamaytiring yoki balansni oshiring
  es: No hay suficiente dinero, reduce la apuesta o aumenta el saldo.
  pt: 
  ar: 
  id: 
  ja: 
  it: 
  de: "Nicht genug Geld, reduzieren Sie den Einsatz oder erh\xF6hen Sie das Guthaben"
