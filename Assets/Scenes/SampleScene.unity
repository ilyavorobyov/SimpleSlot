  m_text: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043E\u0434\u043D\u0443 \u043A\u0430\u0440\u0442\u0443,
    \u0435\u0441\u043B\u0438 \u043E\u043D\u0430 \u0431\u0443\u0434\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
    \u0434\u0440\u0443\u0433\u043E\u0439, \u0432\u044B\u0438\u0433\u0440\u044B\u0448
    \u0443\u0434\u0432\u043E\u0438\u0442\u0441\u044F, \u0435\u0441\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435
    - \u0432\u044B\u0438\u0433\u0440\u044B\u0448 \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043D"
